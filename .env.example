# ================= DocuMind AI – environment configuration =================
# Copy to .env and fill in your values.

# --- App -------------------------------------------------------------------
ENVIRONMENT=development
DEBUG=True
LOG_LEVEL=INFO

# --- Database ---------------------------------------------------------------
# PostgreSQL (production / docker-compose):
DATABASE_URL=postgresql+asyncpg://documind:documind@localhost:5432/documind
# Free tier option: create a free project at https://neon.tech and paste:
# DATABASE_URL=postgresql+asyncpg://USER:PASS@ENDPOINT/dbname?ssl=require
# Zero-setup local dev fallback:
# DATABASE_URL=sqlite+aiosqlite:///./documind.db

# --- LLM (Groq — REQUIRED for Q&A / classification / summarization) ---------
# Get a FREE key at https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
GROQ_BASE_URL=https://api.groq.com/openai/v1
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=1024

# Optional generic OpenAI-compatible fallback provider
OPENAI_API_KEY=

# --- Embeddings / RAG pipeline ----------------------------------------------
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHUNK_SIZE=800
CHUNK_OVERLAP=150
TOP_K=5
MIN_RELEVANCE_SCORE=0.15

# --- Uploads ----------------------------------------------------------------
MAX_UPLOAD_SIZE_MB=25

# --- Dashboard ---------------------------------------------------------------
# Base URL of the FastAPI backend as seen by the browser
PUBLIC_API_BASE=http://localhost:8000
DASHBOARD_PORT=5000
